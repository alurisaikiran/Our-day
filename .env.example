# Copy this file to .env.local for running on your computer.
# On Vercel, add the same names under Project > Settings > Environment Variables.

# Database — added for you automatically when you connect Neon (Postgres) in Vercel > Storage
DATABASE_URL=

# File uploads — added for you automatically when you create a Blob store in Vercel > Storage
BLOB_READ_WRITE_TOKEN=

# A long random string (at least 32 characters). Keeps logins secure.
AUTH_SECRET=

# Your login (admin)
ADMIN_NAME=Sai
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Her login
HER_NAME=
HER_EMAIL=
HER_PASSWORD=

# Time zone used for "today"
APP_TIMEZONE=America/New_York

# AI helper (report checker + learning coach). Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional: pin a model id. If empty, the newest Sonnet model your key can use is picked.
AI_MODEL=
# Any random text. Protects the weekly learning-coach job.
CRON_SECRET=
